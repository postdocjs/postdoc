<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=5.0, minimum-scale=0.86"
    />
    <%- include('color_scheme') %>
    <title><%= (page.title ? page.title + ' | ' : '') %><%= appSettings.name %></title>
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon_16.png" />
    <link rel="icon" type="image/png" sizes="180x180" href="/favicon_180.png" />
    <link rel="stylesheet" href="/css/base.css" />
  </head>
  <body>
    <%- include('header') %>

    <main id="content">
      <h1>API Docs</h1>

      <% if (page.comments) { for (const comment of page.comments) { %>
        <h2><%= comment.name %></h2>
        <p><%- comment.description %></p>
      <% } } %>
    </main>
    
    <%- include('footer') %>
    <script type="module" src="/js/base.js"></script>
  </body>
</html>
