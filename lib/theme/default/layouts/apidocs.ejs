<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=5.0, minimum-scale=0.86"
    />
    <title><%= (page.title ? page.title + ' | ' : '') %><%= appSettings.name %></title>
    <link rel="icon" href="/favicon-32x32.png" type="image/x-icon">
    <link rel="stylesheet" href="/css/base.css" />
  </head>
  <body>
    <%- include('header') %>

    <main>
      <h1>API Docs</h1>

      <% if (page.comments) { for (const comment of page.comments) { %>
        <h2><%= comment.name %></h2>
        <p><%- comment.description %></p>
      <% } } %>
    </main>
    
    <%- include('footer') %>
  </body>
</html>
