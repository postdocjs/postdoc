<%
  // A story page: a story told in full-window storymaps, with text between them. A page
  // uses it with `layout: story` in its front matter. Its chapters are its h2 headings,
  // apart from those that start storymap steps.
  const chapters = [...(page.content ?? '')
    .replace(/<section class="storymap-step"[\s\S]*?<\/section>/g, '')
    .matchAll(/<h2\s[^>]*?id="([^"]*)"[^>]*>([\s\S]*?)<\/h2>/gi)]
    .map(([, id, html]) => ({ id, title: html.replace(/<[^>]+>/g, '').trim() }));
_%>
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= (page.title ? page.title + ' | ' : '') %><%= appSettings.name %></title>
    <%_ if (page.description) { _%>
    <meta name="description" content="<%= page.description %>" />
    <%_ } _%>
    <link rel="icon" href="/favicon-32x32.png" type="image/x-icon">
    <link rel="stylesheet" href="/css/base.css" />
    <link rel="stylesheet" href="/css/highlight.css" />
    <link rel="stylesheet" href="/css/story.css" />
    <%- include('story_head') %>
  </head>
  <body class="storyPage">
    <a class="storySkipLink" href="#story">Skip to the story</a>
    <header class="storyTop">
      <div class="storyBar">
        <a class="storySite" href="/"><%= appSettings.name %></a>
        <%_ if (page.title) { _%>
        <span class="storyTitle"><%= page.title %></span>
        <%_ } _%>
        <label class="storyThemeToggle">
          <input type="checkbox" id="modeToggle" />
          <span class="storyVisuallyHidden">Dark theme</span>
        </label>
      </div>
      <%_ if (chapters.length) { _%>
      <nav class="storyChapters" aria-label="Chapters">
        <ol>
          <%_ for (const chapter of chapters) { _%>
          <li><a href="#<%= chapter.id %>"><%- chapter.title %></a></li>
          <%_ } _%>
        </ol>
      </nav>
      <%_ } _%>
    </header>

    <main id="story" class="storyContent" tabindex="-1" data-storymap-layout="floating">
      <%- page.content %>
    </main>

    <footer class="storyFooter">
      <a href="/">Back to <%= appSettings.name %></a>
      <a class="storyMadeWith" href="https://postdoc.dev"><svg class="storyMadeWithLogo" width="20" height="21" viewBox="0 0 26 27" aria-hidden="true" focusable="false"><path d="M6.44389 7.50632C6.49463 7.91482 6.84981 8.17014 7.25572 8.17014H8.06755C8.57495 8.17014 8.98086 7.76163 8.87938 7.251C8.72716 5.82122 8.06755 4.49358 7.05277 3.47231C6.29168 2.70636 5.83502 1.73615 5.6828 0.714887C5.63206 0.30638 5.32763 0 4.87098 0H4.05915C3.55175 0 3.19658 0.45957 3.24732 0.919141C3.45027 2.55317 4.16062 4.08507 5.27689 5.25953C5.88576 5.87229 6.29168 6.63824 6.44389 7.50632ZM12.1267 7.50632C12.1774 7.91482 12.5326 8.17014 12.9385 8.17014H13.7504C14.2577 8.17014 14.6637 7.76163 14.5622 7.251C14.41 5.82122 13.7504 4.49358 12.7356 3.47231C11.9745 2.70636 11.5178 1.73615 11.3656 0.714887C11.3149 0.30638 11.0104 0 10.5538 0H9.74195C9.23456 0 8.82864 0.45957 8.93012 0.919141C9.13308 2.55317 9.84343 4.08507 10.9597 5.25953C11.5686 5.87229 11.9745 6.63824 12.1267 7.50632ZM20.2957 9.80417H1.62366C0.71035 9.80417 0 10.5701 0 11.4382V21.2424C0 23.9487 2.18179 26.1444 4.87098 26.1444H14.6129C17.3021 26.1444 19.4839 23.9487 19.4839 21.2424H20.2957C23.3908 21.2424 25.9785 18.6892 25.9785 15.5233C25.9785 12.4084 23.3908 9.80417 20.2957 9.80417ZM20.2957 17.9743H19.4839V13.0722H20.2957C21.615 13.0722 22.7312 14.1956 22.7312 15.5233C22.7312 16.902 21.615 17.9743 20.2957 17.9743Z" fill="currentColor"/></svg>Created with PostDoc</a>
    </footer>

    <script type="module" src="/js/base.js"></script>
    <script type="module" src="/js/story.js"></script>
  </body>
</html>
