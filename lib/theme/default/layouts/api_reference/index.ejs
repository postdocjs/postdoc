<%
// The page's headings, h2 to h4, for the table of contents. A heading's id can be
// anywhere among its attributes, and headings without one are left out.
const headings = [...String(page.content || '').matchAll(/<h([2-4])\b([^>]*)>([\s\S]*?)<\/h\1>/gi)]
  .map(([, level, attributes, html]) => ({
    level: Number(level),
    id: attributes.match(/\bid="([^"]*)"/)?.[1],
    text: html.replace(/<[^>]+>/g, '').trim()
  }))
  .filter((heading) => heading.id);

// Each heading goes under the last one before it of a higher level: an h3 under its h2,
// and an h4 under its h3.
const tocItems = [];
const parents = [];
for (const heading of headings) {
  const item = { url: '#' + heading.id, label: heading.text, items: [] };

  while (parents.length && parents.at(-1).level >= heading.level) {
    parents.pop();
  }

  (parents.at(-1)?.item.items ?? tocItems).push(item);
  parents.push({ level: heading.level, item });
}

const firstH2 = headings.find(h => h.level === 2);
const rightSidebarData = {
  titleUrl: firstH2 ? '#' + firstH2.id : '#',
  titleLabel: page.title || (firstH2 ? firstH2.text : 'On this page'),
  items: tocItems,
  // The h2 and h3 headings in a flat list, for a table of contents that doesn't nest them.
  links: headings.filter(h => h.level < 4).map(h => ({
    linkUrl: '#' + h.id,
    linkLabel: h.text
  }))
};
%>

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=5.0, minimum-scale=0.86"
    />
    <%- include('color_scheme') %>
    <title><%= (page.title ? page.title + ' | ' : '') %><%= appSettings.name %></title>
    <link rel="icon" href="/favicon-32x32.png" type="image/x-icon">
    <link rel="stylesheet" href="/css/base.css" />
    <link rel="stylesheet" href="/css/api_reference.css" />
    <link rel="stylesheet" href="/css/highlight.css" />
  </head>
  <body id="api">
    <%- include('header') %>
    <%- include('mobile_sidesmenuapi_header') %>
    <div id="container">
        <%- include('left_api_menu') %>

        <div id="content">
          <%- page.content %>

          <%- include('edit_link') %>
          <%# The API pages follow appSettings.apiNav, or appSettings.nav without one. %>
          <%- include('prev_next', { items: appSettings.apiNav ?? appSettings.nav }) %>
        </div>
        <%- include('api_right_sidebar', rightSidebarData) %>
    </div>
    <%- include('footer-inner-pages') %>
    <script type="module" src="/js/base.js"></script>
    <script type="module" src="/js/toggleSideMenu.js"></script>
  </body>
</html>
