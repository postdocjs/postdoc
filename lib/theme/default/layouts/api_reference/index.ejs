<%
// Auto-extract headings from page content for right sidebar TOC
const headingRegex = /<h([2-3])\s+id="([^"]*)"[^>]*>(.*?)<\/h[2-3]>/gi;
const headings = [];
let headingMatch;
const contentStr = String(page.content || '');
while ((headingMatch = headingRegex.exec(contentStr)) !== null) {
  headings.push({
    level: parseInt(headingMatch[1]),
    id: headingMatch[2],
    text: headingMatch[3].replace(/<[^>]+>/g, '')
  });
}

// Build right sidebar data from extracted headings
const firstH2 = headings.find(h => h.level === 2);
const rightSidebarData = {
  titleUrl: firstH2 ? '#' + firstH2.id : '#',
  titleLabel: page.title || (firstH2 ? firstH2.text : 'On this page'),
  links: headings.filter(h => h.level === 2 || h.level === 3).map(h => ({
    linkUrl: '#' + h.id,
    linkLabel: h.text
  }))
};

// Build flat page list from apiNav (if defined in appSettings) for prev/next
const apiPages = [];
if (appSettings.apiNav) {
  appSettings.apiNav.forEach(function(item) {
    if (item.children) {
      item.children.forEach(function(child) { apiPages.push(child); });
    } else if (item.url) {
      apiPages.push(item);
    }
  });
} else if (appSettings.nav) {
  // Fallback: extract from main nav
  appSettings.nav.forEach(function(section) {
    if (section.children) {
      section.children.forEach(function(child) {
        if (child.children) {
          child.children.forEach(function(sc) { apiPages.push(sc); });
        } else {
          apiPages.push(child);
        }
      });
    }
  });
}

let currentIndex = -1;
const currentUrl = page.url || '';
for (let i = 0; i < apiPages.length; i++) {
  if (currentUrl.includes(apiPages[i].url.replace(/\/$/, ''))) {
    currentIndex = i;
    break;
  }
}
const prevPage = currentIndex > 0 ? apiPages[currentIndex - 1] : null;
const nextPage = currentIndex >= 0 && currentIndex < apiPages.length - 1 ? apiPages[currentIndex + 1] : null;
%>

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=5.0, minimum-scale=0.86"
    />
    <title><%= (page.title ? page.title + ' | ' : '') %><%= appSettings.name %></title>
    <link rel="icon" href="/favicon-32x32.png" type="image/x-icon">
    <link rel="stylesheet" href="/css/base.css" />
    <link rel="stylesheet" href="/css/api_reference.css" />
    <link rel="stylesheet" href="/css/highlight.css" />
  </head>
  <body id="api">
    <%- include('header') %>
    <%- include('mobile_sidesmenuapi_header') %>
    <div id="container">
        <%- include('left_api_menu') %>

        <div id="content">
          <%- page.content %>
          <div class="prev-next-section">
            <%_ if (prevPage) { _%>
            <a href="<%= prevPage.url %>" class="prev">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
              </svg>
              <div>Back to <span><%= prevPage.title %></span></div>           
            </a>
            <%_ } else { _%>
            <span></span>
            <%_ } _%>
            <%_ if (nextPage) { _%>
            <a href="<%= nextPage.url %>" class="next">            
              <div>Go to <span><%= nextPage.title %></span></div>  
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>          
            </a>
            <%_ } else { _%>
            <span></span>
            <%_ } _%>
          </div>
        </div>
        <%- include('api_right_sidebar', rightSidebarData) %>
    </div>
    <%- include('footer-inner-pages') %>
    <script type="module" src="/js/base.js"></script>
    <script type="module" src="/js/toggleSideMenu.js"></script>
  </body>
</html>
