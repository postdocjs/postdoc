<%#
  Links to the previous and the next page, in the order of `items`, the navigation they
  follow, such as appSettings.nav. A page's front matter can change either link, or
  leave it out:

    prev: false
    next:
      text: Deploy your site
      link: /guide/deployment.html

  Without `text`, the link has the title that its page has in the navigation. Without
  `link`, it leads where it would anyway, with the text.
%>
<%
  // /guide/, /guide/index.html and /guide are the same page.
  const normalizeUrl = (url) => String(url ?? '').split(/[?#]/)[0].replace(/(\/index)?\.html$/, '').replace(/\/+$/, '') || '/';
  // The pages of this site in the navigation, each once: not links to other sites.
  const isSitePage = (url) => typeof url === 'string' && url !== '' && !/^[a-z][a-z\d+.-]*:/i.test(url);
  const flatten = (list) => (list ?? []).flatMap((item) => [
    ...(isSitePage(item.url) ? [{ title: item.title, url: item.url }] : []),
    ...flatten(item.children)
  ]);

  const navPages = flatten(items).filter((navPage, position, all) =>
    all.findIndex((other) => normalizeUrl(other.url) === normalizeUrl(navPage.url)) === position);
  const findPage = (url) => navPages.find((navPage) => normalizeUrl(navPage.url) === normalizeUrl(url));
  const index = navPages.indexOf(findPage(page.url));

  const pickLink = (setting, neighbour) => {
    if (setting === false) {
      return null;
    }

    if (setting && typeof setting === 'object') {
      const url = setting.link ?? neighbour?.url;

      return url ? { url, title: setting.text ?? findPage(url)?.title ?? url } : null;
    }

    return neighbour;
  };

  const prevPage = pickLink(page.prev, index > 0 ? navPages[index - 1] : null);
  const nextPage = pickLink(page.next, index >= 0 ? navPages[index + 1] ?? null : null);
%>
<%_ if (prevPage || nextPage) { _%>
<nav class="prev-next-section" aria-label="Previous and next pages" data-pagefind-ignore>
  <%_ if (prevPage) { _%>
  <a href="<%= prevPage.url %>" class="prev" rel="prev">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
    </svg>
    <div>Back to <span><%= prevPage.title %></span></div>
  </a>
  <%_ } else { _%>
  <span></span>
  <%_ } _%>
  <%_ if (nextPage) { _%>
  <a href="<%= nextPage.url %>" class="next" rel="next">
    <div>Go to <span><%= nextPage.title %></span></div>
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
    </svg>
  </a>
  <%_ } _%>
</nav>
<%_ } _%>
