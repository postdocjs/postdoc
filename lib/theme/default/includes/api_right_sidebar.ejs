<%#
  The table of contents of a page. Takes `titleUrl` and `titleLabel`, for its first link,
  and `items`, the page's headings: each with its `url`, its `label` and the `items`
  under it. A layout also passes `links`, the h2 and h3 headings in a flat list, for an
  include of its own that doesn't nest them.
%>
<%
  const headingItems = locals.items ?? links.map(({ linkUrl, linkLabel }) => ({ url: linkUrl, label: linkLabel, items: [] }));
  // A page without an h2 has no heading to link the title to, so it leads to the top of
  // the content, which every layout of the theme has.
  const titleHref = titleUrl && titleUrl !== '#' ? titleUrl : '#content';
%>
<%_ function renderItems(list, className) { _%>
<ul<%- className ? ` class="${className}"` : '' %>>
    <%_ for (const { url, label, items: children } of list) { _%>
    <li>
        <a href="<%= url %>"><%- label %></a>
        <%_ if (children?.length) renderItems(children); _%>
    </li>
    <%_ } _%>
</ul>
<%_ } _%>
<div class="right-sidebar-container" data-pagefind-ignore>
    <div id="right-sidebar">
        <nav id="toc" aria-label="On this page">
            <div class="sidebar-header right-sidebar-mobileHeader">
                <button type="button" class="right-sidebar-close-button sidebar-close-button" aria-label="Close the contents">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" id="closeRightSidebarButton" class="w-6 h-6 closeBtnMenu" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>
            <ul>
                <li>
                    <a href="<%= titleHref %>"><%- titleLabel %></a>
                    <%_ renderItems(headingItems, 'innerList'); _%>
                </li>
            </ul>
        </nav>
    </div>
</div>
