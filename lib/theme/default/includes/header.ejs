<%
  // The repository, from appSettings.github: its address, 'owner/repo', or an object
  // with either as its `repo`.
  const github = appSettings.github;
  const repo = String((typeof github === 'object' ? github?.repo : github) ?? '').trim();
  const repoUrl = repo && (/^https?:\/\//.test(repo) ? repo : `https://github.com/${repo}`).replace(/(\.git)?\/*$/, '');

  // The versions of the site, from appSettings.versions: [{ title, url, current }].
  const versions = Array.isArray(appSettings.versions) ? appSettings.versions : [];
  const currentVersion = versions.find((version) => version.current);
  const versionLabel = currentVersion?.title ?? (appSettings.version ? String(appSettings.version).replace(/^(?!v)/, 'v') : 'Version');

  const hasSearch = configuration.pagefind?.enabled !== false;
%>
<link rel="stylesheet" href="/css/header.css" />

<%# Every layout with this header has its content in #content. %>
<a class="skip-link" href="#content">Skip to content</a>

<header id="topHeaderComponent">
    <div class="header-inner">
        <a href="/" class="logo" aria-label="Homepage">
            <div class="logo-img"></div>
        </a>
        <div class="menuList">
            <div class="docThemeContainer" id="docThemeContainer">
                <nav class="docThemeNav" aria-label="Main">
                    <ul class="docThemeMenu">
                        <li><a href="/">Homepage</a></li>
                        <%_ if (appSettings.headerNav) { _%>
                            <%_ appSettings.headerNav.forEach(function(item) { _%>
                                <li><a href="<%= item.url %>"><%= item.title %></a></li>
                            <%_ }); _%>
                        <%_ } _%>
                    </ul>
                </nav>

                <div class="navigationList">
                    <%_ if (hasSearch) { _%>
                    <div class="searchBar">
                        <div class="docThemeSearchBox">
                            <button type="button" class="searchBtn" aria-label="Search" aria-haspopup="dialog"></button>
                            <button type="button" class="searchBarMobile" aria-haspopup="dialog">
                                <span class="searchIcon" aria-hidden="true"></span>
                                <span>Search</span>
                            </button>
                        </div>
                    </div>
                    <%_ } _%>
                    <div class="mobileIcons">
                        <%_ if (versions.length) { _%>
                        <div class="docThemeVersionDropdown">
                            <button type="button" id="dropdownBtn" aria-expanded="false" aria-controls="versionMenu"><span class="visually-hidden">Version: </span><%= versionLabel %></button>
                            <ul class="dropdown-content" id="versionMenu" hidden>
                                <%_ versions.forEach(function(version) { _%>
                                <li><a href="<%= version.url ?? version.href %>"<%- version.current ? ' aria-current="true"' : '' %>><%= version.title %></a></li>
                                <%_ }); _%>
                            </ul>
                        </div>
                        <%_ } _%>
                        <fieldset class="themeSwitch">
                            <legend class="visually-hidden">Theme</legend>
                            <label title="Light">
                                <input type="radio" name="pd-theme" value="light">
                                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" /></svg>
                                <span class="visually-hidden">Light</span>
                            </label>
                            <label title="Match the system">
                                <input type="radio" name="pd-theme" value="system">
                                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="2" y="3" width="20" height="14" rx="2" /><path d="M8 21h8M12 17v4" /></svg>
                                <span class="visually-hidden">Match the system</span>
                            </label>
                            <label title="Dark">
                                <input type="radio" name="pd-theme" value="dark">
                                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" /></svg>
                                <span class="visually-hidden">Dark</span>
                            </label>
                        </fieldset>
                        <%_ if (repoUrl) { _%>
                        <div>
                            <a href="<%= repoUrl %>" aria-label="GitHub repository">
                                <div class="social-icon github"></div>
                            </a>
                        </div>
                        <%_ } _%>
                    </div>
                </div>
            </div>
            <button type="button" class="menuButton" aria-label="Menu" aria-expanded="false" aria-controls="docThemeContainer">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M12 17.25h8.25" />
                </svg>
            </button>
        </div>
    </div>
</header>

<%_ if (hasSearch) { _%>
<dialog id="mySearchModal" class="searchModal" aria-label="Search">
    <div class="searchModal-content">
        <div id="pagefind-search"></div>
    </div>
</dialog>
<%_ } _%>

<script type="module" src="/js/header.js"></script>
