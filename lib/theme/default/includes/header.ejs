<link rel="stylesheet" href="/css/header.css" />

<header id="topHeaderComponent">
    <div class="header-inner">
        <a href="/" class="logo" aria-label="Homepage">
            <div class="logo-img"></div>
        </a>
        <div class="menuList">
            <div class="docThemeContainer">
                <nav class="docThemeNav">
                    <ul class="docThemeMenu">
                        <li><a href="/">Homepage</a></li>
                        <%_ if (appSettings.headerNav) { _%>
                            <%_ appSettings.headerNav.forEach(function(item) { _%>
                                <li><a href="<%= item.url %>"><%= item.title %></a></li>
                            <%_ }); _%>
                        <%_ } _%>
                    </ul>
                </nav>

                <div class="navigationList">
                    <div class="searchBar">
                        <div class="docThemeSearchBox">
                            <button class="searchBtn" aria-label="Search"></button>
                            <div class="searchBarMobile">
                                <div class="searchIcon"></div>
                                <input type="text" placeholder="Search..." name="" id="">
                            </div>
                        </div>
                    </div>
                    <div class="mobileIcons">
                        <div class="themeBtn">
                            <label class="switch">
                                <input type="checkbox" id="modeToggle">
                                <span class="slider round"></span>
                            </label>
                        </div>
                        <div>
                            <a href="#" aria-label="Github icon">
                                <div class="social-icon github"></div>
                            </a>
                        </div>
                    </div>

                </div>
            </div>
            <button class="menuButton" aria-label="Menu">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M12 17.25h8.25" />
                </svg>
            </button>
        </div>
    </div>
</header>

<div id="mySearchModal" class="searchModal">
    <div class="searchModal-content">
        <div id="pagefind-search"></div>
    </div>
</div>

<script type="module" src="/js/header.js"></script>
