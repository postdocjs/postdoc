<%#
  The navigation in a sidebar: sections that open and close, with links in them, and
  groups of links in a section that open and close too. Takes `items`, the sections,
  such as appSettings.nav, `label`, the navigation's name for assistive technology, and
  `prefix`, which tells the sections of one sidebar from another's. The sections and
  groups with the current page in them are open.
%>
<%
  // /guide/, /guide/index.html and /guide are the same page.
  const normalizeUrl = (url) => String(url ?? '').split(/[?#]/)[0].replace(/(\/index)?\.html$/, '').replace(/\/+$/, '') || '/';
  const currentUrl = normalizeUrl(page.url);
  const isCurrent = (item) => Boolean(item.url) && normalizeUrl(item.url) === currentUrl;
  const hasCurrent = (item) => isCurrent(item) || (item.children ?? []).some(hasCurrent);
%>
<%_ function renderLink(item, className) { _%>
<a href="<%= item.url %>"<%- className ? ` class="${className}"` : '' %><%- isCurrent(item) ? ' aria-current="page"' : '' %>><%= item.title %></a>
<%_ } _%>
<%_ function renderItems(items, id) { _%>
<ul<%- id === prefix ? ' class="sidebar-sections"' : '' %>>
  <%_ items.forEach(function (item, index) { _%>
  <li>
    <%_ if (item.children) { _%>
    <details class="<%= id === prefix ? 'sidebar-section' : 'sidebar-group' %>" data-nav-id="<%= id %>-<%= index %>"<%= hasCurrent(item) ? ' open' : '' %>>
      <summary><%= item.title %></summary>
      <%_ if (item.url) { _%>
      <%_ renderItems([{ title: item.title, url: item.url }].concat(item.children), id + '-' + index); _%>
      <%_ } else { _%>
      <%_ renderItems(item.children, id + '-' + index); _%>
      <%_ } _%>
    </details>
    <%_ } else { _%>
    <%_ renderLink(item, id === prefix ? 'sidebar-link' : ''); _%>
    <%_ } _%>
  </li>
  <%_ }); _%>
</ul>
<%_ } _%>
<nav class="sidebar-nav" aria-label="<%= label %>" data-pagefind-ignore>
  <p class="sidebar-filter-status visually-hidden" aria-live="polite"></p>
  <%_ renderItems(items ?? [], prefix); _%>
</nav>
