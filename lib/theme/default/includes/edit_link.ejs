<%#
  A link to edit the page on GitHub. appSettings.editLink names the repository and the
  branch that the pages are on:

    editLink: { repo: 'acme/docs', branch: 'main', dir: 'website' }

  Without it, appSettings.github is used, when it's an object with a branch. `dir` is the
  project's folder in the repository, when the project isn't at its top. `editLink: false`
  leaves the link out of every page, and a page can leave it out with `editLink: false`
  in its front matter.
%>
<%
  const settings = appSettings.editLink ?? (typeof appSettings.github === 'object' ? appSettings.github : null);
  const repo = typeof settings?.repo === 'string' ? settings.repo.trim() : '';
  const repoUrl = repo && (/^https?:\/\//.test(repo) ? repo : `https://github.com/${repo}`).replace(/(\.git)?\/*$/, '');
  const dir = String(settings?.dir ?? '').replace(/^\/+|\/+$/g, '');
  const editUrl = repoUrl && settings.branch && page.sourcePath && page.editLink !== false
    ? `${repoUrl}/edit/${settings.branch}/${encodeURI((dir ? dir + '/' : '') + page.sourcePath)}`
    : null;
%>
<%_ if (editUrl) { _%>
<p class="edit-page"><a class="edit-link" href="<%= editUrl %>">Edit this page on GitHub</a></p>
<%_ } _%>
