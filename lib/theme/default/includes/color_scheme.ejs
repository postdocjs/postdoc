<%# The reader's colour scheme, set before the page is painted, so that a dark page
    doesn't flash light while it loads. It's the one they chose with the theme switch,
    light or dark, or else their system's. js/base.js keeps it up to date. %>
<script>
  (function () {
    var theme;

    try {
      theme = localStorage.getItem('theme');
    } catch (error) {}

    if (theme !== 'light' && theme !== 'dark') {
      theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    }

    document.documentElement.setAttribute('data-theme', theme);
  })();
</script>
