<div id="left-sidebar">
    <div class="left-sidebar-content">
        <div class="sidebar-header left-sidebar-mobileHeader">
            <div class="left-sidebar-title">
              <div class="guideIcon" aria-hidden="true"></div>
              <h3>Developer Guide</h3>
            </div>
            <button type="button" id="closeLeftSidebarButton" class="sidebar-close-button" aria-label="Close the guide's pages">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 closeBtnMenu" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
        </div>
        <div class="left-sidebar-search sidebar-filter">
            <div class="searchIcon" aria-hidden="true"></div>
            <input type="search" placeholder="Filter..." aria-label="Filter the guide's pages" autocomplete="off">
        </div>
        <%- include('sidebar_nav', { items: appSettings.nav, label: 'Guide', prefix: 'guide' }) %>
    </div>
</div>
