<div id="left-sidebar">
    <div class="left-sidebar-content">
        <div class="sidebar-header left-sidebar-mobileHeader">
            <div class="left-sidebar-title">
              <div class="guideIcon"></div>
              <h3>Developer Guide</h3>
            </div>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" id="closeLeftSidebarButton" class="w-6 h-6 closeBtnMenu">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg> 
        </div>
        <div class="left-sidebar-search">
            <div class="searchIcon"></div>
            <input type="text" placeholder="Filter..." name="" id="">
        </div>
        <nav>
            <%_ if (appSettings.nav) { _%>
                <%_ appSettings.nav.forEach(function(section, sectionIndex) { _%>
                    <%
                      var isActive = section.children && section.children.some(function(c) {
                        if (c.children) {
                          return c.children.some(function(sc) {
                            return page.url && page.url.includes(sc.url.replace(/\/$/, ''));
                          });
                        }
                        return page.url && page.url.includes(c.url.replace(/\/$/, ''));
                      });
                    %>
                    <div class="accordion-item<%= isActive ? ' active' : '' %>">
                        <div class="accordion-header" data-index="<%= sectionIndex + 1 %>"><%= section.title %></div>
                        <%_ if (section.children) { _%>
                            <div class="accordion-content">
                                <%_ section.children.forEach(function(child) { _%>
                                    <%_ if (child.children) { _%>
                                        <div class="accordion-sub-group">
                                            <div class="accordion-sub-header"><%= child.title %></div>
                                            <div class="accordion-sub-content">
                                                <%_ child.children.forEach(function(subChild) { _%>
                                                    <a href="<%= subChild.url %>"<%= page.url && page.url.includes(subChild.url.replace(/\/$/, '')) ? ' class="active"' : '' %>><%= subChild.title %></a>
                                                <%_ }); _%>
                                            </div>
                                        </div>
                                    <%_ } else { _%>
                                        <a href="<%= child.url %>"<%= page.url && page.url.includes(child.url.replace(/\/$/, '')) ? ' class="active"' : '' %>><%= child.title %></a>
                                    <%_ } _%>
                                <%_ }); _%>
                            </div>
                        <%_ } _%>
                    </div>
                <%_ }); _%>
            <%_ } _%>
        </nav>
    </div>
</div>
