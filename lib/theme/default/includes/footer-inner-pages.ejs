<link rel="stylesheet" href="/css/footer.css" />

<footer class="footerPages">
    <div class="footer-inner">
        <div class="footer-upperRow">
            <div class="column columnOne">
                <div class="footer-logo"></div>
                <p class="footer-address-upper"><%= appSettings.name %></p>
            </div>
            <div class="column columnTwo">
                <h3>Quick Links</h3>
                <div class="footerLinks">
                    <%_ if (appSettings.headerNav) { _%>
                    <ul>
                        <li><a href="/">Homepage</a></li>
                        <%_ appSettings.headerNav.forEach(function(item) { _%>
                            <li><a href="<%= item.url %>"><%= item.title %></a></li>
                        <%_ }); _%>
                    </ul>
                    <%_ } _%>
                </div>
            </div>
        </div>
        <div class="footer-bottomRow">
            <div>
                <p class="right-footer-desktop">&copy; <%= new Date().getFullYear() %> <%= appSettings.name %>. All rights reserved.</p>
            </div>
        </div>
    </div>
</footer>
