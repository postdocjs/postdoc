{
  "name": "postdoc",
  "type": "module",
  "version": "0.3.0-preview4",
  "license": "MIT",
  "description": "Create delightful documentation websites with ease.",
  "bin": {
    "postdoc": "./bin/postdoc.js"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts"
    },
    "./dom": {
      "types": "./types/dom.d.ts",
      "default": "./client/dom/index.js"
    },
    "./client": {
      "types": "./types/client.d.ts",
      "default": "./client/index.js"
    },
    "./page": {
      "types": "./types/page.d.ts",
      "default": "./client/page/index.js"
    },
    "./storymap": {
      "types": "./types/storymap.d.ts",
      "default": "./client/storymap/index.js"
    },
    "./playground": {
      "types": "./types/playground.d.ts",
      "default": "./client/playground/index.js"
    },
    "./notebook": {
      "types": "./types/notebook.d.ts",
      "default": "./client/notebook/index.js"
    },
    "./math": {
      "types": "./types/math.d.ts",
      "default": "./client/math/index.js"
    }
  },
  "types": "./types/index.d.ts",
  "scripts": {
    "test:e2e": "nightwatch --config nightwatch.conf.js",
    "test:unit": "nightwatch --config nightwatch.conf.js --env unittests",
    "test:coverage": "c8 npm run test:unit",
    "lint": "eslint ."
  },
  "files": [
    "bin",
    "client",
    "extra",
    "lib",
    "types",
    "LICENSE",
    "README.md",
    "package.json",
    "package-lock.json"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^22.20.5",
    "c8": "^12.0.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "tree-kill": "^1.2.2",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^2.0.0"
  },
  "dependencies": {
    "@halo-lab/iterable": "^0.0.1",
    "@halo-lab/stream": "^0.0.1",
    "@pineview/ejs": "0.3.0-preview",
    "anymatch": "^3.1.3",
    "arcsecond": "^5.0.0",
    "chalk": "^6.0.1",
    "chokidar": "^5.0.0",
    "commander": "^15.0.0",
    "deepmerge": "^4.2.2",
    "dotenv": "^18.0.8",
    "figlet": "^1.12.0",
    "inquirer": "^14.2.3",
    "js-yaml": "^5.5.0",
    "jsdoctypeparser": "^9.0.0",
    "katex": "0.18.10",
    "marked": "^18.1.1",
    "marked-gfm-heading-id": "^4.1.4",
    "marked-katex-extension": "^5.1.13",
    "ora": "^9.4.1",
    "pagefind": "^1.5.2",
    "pipe-ts": "^0.0.9",
    "shiki": "^4.5.0",
    "stacktrace-parser": "^0.1.10",
    "vite": "^8.3.4"
  },
  "peerDependencies": {
    "vite-plugin-pwa": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "vite-plugin-pwa": {
      "optional": true
    }
  }
}
