<%
// The table of contents on the right: the page's headings, the first one at the top.
const headings = [...String(page.content || '').matchAll(/<h([1-3])\s+id="([^"]*)"[^>]*>([\s\S]*?)<\/h\1>/gi)]
  .map(([, level, id, html]) => ({ level: Number(level), id, text: html.replace(/<[^>]+>/g, '').trim() }));
const top = headings.find((heading) => heading.level === 1) ?? headings[0];
const rightSidebarData = {
  titleUrl: top ? `#${top.id}` : null,
  titleLabel: top ? top.text : page.title ?? '',
  links: headings
    .filter((heading) => heading !== top && heading.level > 1)
    .map((heading) => ({ linkUrl: `#${heading.id}`, linkLabel: heading.text }))
};
%>

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=5.0, minimum-scale=0.86"
    />
    <title><%= appSettings.name %></title>
    <style id="fonts">
      @import url('https://fonts.googleapis.com/css2?family=Titillium+Web:wght@200;300;400;600;700&display=swap');
    </style>
    <style id="base-styles">
      @import "/src/css/base.css";
    </style>
    <link rel="stylesheet" href="/src/css/api_reference.css" />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/favicon_16.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="180x180"
      href="/favicon_180.png"
    />
  </head>
  <body>
    <%- include('header') %>
    <%- include('mobile_sidesmenu_header') %>

    <div id="container">
        <%- include('left_api_menu') %>

        <div id="content">
          <%- page.content %>
        </div>

        <%- include('api_right_sidebar', rightSidebarData) %>
    </div>

    <%- include('footer') %>

    <script type="module" src="/src/js/base.js"></script>
    <script type="module" src="/src/js/toggleSideMenu.js"></script>
  </body>
</html>
